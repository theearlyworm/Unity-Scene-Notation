// ============================================================================
// SCENE BUILDER - Creates actual Unity objects from parsed data
// ============================================================================

public class SceneBuilder
{
private int objectsCreated = 0;
private int objectsReused = 0;
private int componentsAdded = 0;
private int errorsEncountered = 0;
private List<string> errorMessages = new List<string>();

```
public void BuildScene(List<NotationParser.SceneNode> nodes)
{
    foreach (var node in nodes)
    {
        ProcessNode(node, null);
    }
}

private GameObject ProcessNode(NotationParser.SceneNode node, GameObject parent)
{
    if (node.type == NotationParser.NodeType.GameObject)
    {
        GameObject go = FindOrCreateGameObject(node.name, parent);

        // Process children (components and child GameObjects)
        foreach (var child in node.children)
        {
            if (child.type == NotationParser.NodeType.GameObject)
            {
                ProcessNode(child, go);
            }
            else if (child.type == NotationParser.NodeType.Component)
            {
                AddComponentToGameObject(go, child.name);
            }
            else if (child.type == NotationParser.NodeType.Asset)
            {
                Debug.Log($"Asset reference noted on {go.name}: {child.name}");
            }
            else if (child.type == NotationParser.NodeType.Reference)
            {
                Debug.Log($"Reference noted on {go.name}: {child.name}");
            }
        }

        return go;
    }

    return null;
}

private GameObject FindOrCreateGameObject(string name, GameObject parent)
{
    GameObject go = null;

    // Try to find existing GameObject
    if (parent == null)
    {
        // Search at root level
        var rootObjects = UnityEngine.SceneManagement.SceneManager.GetActiveScene().GetRootGameObjects();
        go = rootObjects.FirstOrDefault(obj => obj.name == name);
    }
    else
    {
        // Search in children
        var transform = parent.transform.Find(name);
        if (transform != null)
        {
            go = transform.gameObject;
        }
    }

    if (go != null)
    {
        objectsReused++;
        Debug.Log($"Reusing existing GameObject: {name}");
    }
    else
    {
        go = new GameObject(name);
        if (parent != null)
        {
            go.transform.SetParent(parent.transform);
        }
        objectsCreated++;
        Undo.RegisterCreatedObjectUndo(go, "Create GameObject from Notation");
    }

    return go;
}

private void AddComponentToGameObject(GameObject go, string componentName)
{
    // Check if component already exists
    Type componentType = FindComponentType(componentName);

    if (componentType == null)
    {
        string error = $"Component '{componentName}' not found in project or Unity assemblies. Skipping.";
        errorMessages.Add(error);
        errorsEncountered++;
        Debug.LogWarning(error);
        return;
    }

    // Check if already has this component
    if (go.GetComponent(componentType) != null)
    {
        Debug.Log($"GameObject '{go.name}' already has {componentName}. Skipping.");
        return;
    }

    try
    {
        Undo.AddComponent(go, componentType);
        componentsAdded++;
        Debug.Log($"Added {componentName} to {go.name}");
    }
    catch (Exception e)
    {
        string error = $"Failed to add {componentName} to {go.name}: {e.Message}";
        errorMessages.Add(error);
        errorsEncountered++;
        Debug.LogError(error);
    }
}

private Type FindComponentType(string name)
{
    // Clean up the name
    name = name.Trim();

    // Try Unity's built-in components first
    Type type = Type.GetType($"UnityEngine.{name}, UnityEngine");
    if (type != null && typeof(Component).IsAssignableFrom(type))
    {
        return type;
    }

    // Try UnityEngine.UI
    type = Type.GetType($"UnityEngine.UI.{name}, UnityEngine.UI");
    if (type != null && typeof(Component).IsAssignableFrom(type))
    {
        return type;
    }

    // Search all loaded assemblies for custom scripts
    foreach (var assembly in AppDomain.CurrentDomain.GetAssemblies())
    {
        // Skip system assemblies for performance
        if (assembly.FullName.StartsWith("System") || 
            assembly.FullName.StartsWith("mscorlib") ||
            assembly.FullName.StartsWith("netstandard"))
            continue;

        type = assembly.GetTypes()
            .FirstOrDefault(t => t.Name == name && typeof(Component).IsAssignableFrom(t));

        if (type != null)
        {
            return type;
        }
    }

    return null;
}

public string GetStats()
{
    string stats = $"Objects Created: {objectsCreated}\n" +
                  $"Objects Reused: {objectsReused}\n" +
                  $"Components Added: {componentsAdded}";

    if (errorsEncountered > 0)
    {
        stats += $"\n\nErrors: {errorsEncountered}";
        stats += "\n" + string.Join("\n", errorMessages.Take(5));
        if (errorMessages.Count > 5)
        {
            stats += $"\n... and {errorMessages.Count - 5} more (see Console)";
        }
    }

    return stats;
}
