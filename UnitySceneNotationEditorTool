/// <summary>
/// Unity Editor tool to build scene hierarchies from custom text notation
/// Usage: Tools > Scene Notation Builder
/// </summary>
public class SceneNotationBuilder : EditorWindow
{
private string notationText = “”;
private Vector2 scrollPos;
private bool showHelp = false;

```
[MenuItem("Tools/Scene Notation Builder")]
public static void ShowWindow()
{
    GetWindow<SceneNotationBuilder>("Scene Notation Builder");
}

void OnGUI()
{
    GUILayout.Label("Scene Notation Builder", EditorStyles.boldLabel);
    
    if (GUILayout.Button(showHelp ? "Hide Help" : "Show Help"))
    {
        showHelp = !showHelp;
    }

    if (showHelp)
    {
        EditorGUILayout.HelpBox(
            "Notation Guide:\n" +
            ":: {{ GameObject }} - Create/find GameObject\n" +
            "^:: *ComponentName* - Add component\n" +
            "^:: <<AssetName>> - Asset reference (noted but not assigned)\n" +
            "+ (( ComponentName )) - Add component\n" +
            "^||___ Name - Reference (noted)\n\n" +
            "Indentation shows hierarchy. Duplicates are merged.",
            MessageType.Info);
    }

    GUILayout.Space(10);
    GUILayout.Label("Paste your notation below:", EditorStyles.label);
    
    scrollPos = EditorGUILayout.BeginScrollView(scrollPos, GUILayout.Height(300));
    notationText = EditorGUILayout.TextArea(notationText, GUILayout.ExpandHeight(true));
    EditorGUILayout.EndScrollView();

    GUILayout.Space(10);

    if (GUILayout.Button("Build Scene", GUILayout.Height(30)))
    {
        BuildSceneFromNotation();
    }

    if (GUILayout.Button("Clear Text"))
    {
        notationText = "";
    }
}

void BuildSceneFromNotation()
{
    if (string.IsNullOrWhiteSpace(notationText))
    {
        EditorUtility.DisplayDialog("Error", "Please enter notation text first!", "OK");
        return;
    }

    try
    {
        var parser = new NotationParser();
        var nodes = parser.Parse(notationText);
        
        var builder = new SceneBuilder();
        builder.BuildScene(nodes);
        
        EditorUtility.DisplayDialog("Success", 
            $"Scene built successfully!\n{builder.GetStats()}", "OK");
    }
    catch (Exception e)
    {
        EditorUtility.DisplayDialog("Error", $"Failed to build scene:\n{e.Message}", "OK");
        Debug.LogError($"Scene Notation Builder Error: {e}");
    }
}
