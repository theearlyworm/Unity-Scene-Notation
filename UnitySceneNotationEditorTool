// ============================================================================
// PARSER - Reads notation and creates data structure
// ============================================================================

public class NotationParser
{
private class LineInfo
{
public string rawLine;
public int indentLevel;
public string content;
public NodeType type;
public string name;
}

```
public enum NodeType
{
    GameObject,
    Component,
    Asset,
    Reference,
    Unknown
}

public class SceneNode
{
    public NodeType type;
    public string name;
    public int indentLevel;
    public List<SceneNode> children = new List<SceneNode>();
    public SceneNode parent;
}

public List<SceneNode> Parse(string notation)
{
    var lines = notation.Split('\n');
    var lineInfos = new List<LineInfo>();

    // First pass: parse each line
    foreach (var line in lines)
    {
        if (string.IsNullOrWhiteSpace(line)) continue;

        var info = ParseLine(line);
        if (info != null && info.type != NodeType.Unknown)
        {
            lineInfos.Add(info);
        }
    }

    // Second pass: build hierarchy
    return BuildHierarchy(lineInfos);
}

private LineInfo ParseLine(string line)
{
    var info = new LineInfo { rawLine = line };
    
    // Calculate indent level (groups of 4 spaces or 1 tab = 1 level)
    int spaces = 0;
    foreach (char c in line)
    {
        if (c == ' ') spaces++;
        else if (c == '\t') spaces += 4;
        else break;
    }
    info.indentLevel = spaces / 4;

    // Get content without leading whitespace
    info.content = line.TrimStart();

    // Determine type and extract name
    if (info.content.Contains("{{ ") && info.content.Contains(" }}"))
    {
        info.type = NodeType.GameObject;
        info.name = ExtractBetween(info.content, "{{ ", " }}");
    }
    else if (info.content.Contains("[[ ") && info.content.Contains(" ]]"))
    {
        info.type = NodeType.GameObject;
        info.name = ExtractBetween(info.content, "[[ ", " ]]");
    }
    else if (info.content.Contains("*") && info.content.Split('*').Length >= 3)
    {
        info.type = NodeType.Component;
        info.name = ExtractBetween(info.content, "*", "*");
    }
    else if (info.content.Contains("(( ") && info.content.Contains(" ))"))
    {
        info.type = NodeType.Component;
        info.name = ExtractBetween(info.content, "(( ", " ))");
    }
    else if (info.content.Contains("<<") && info.content.Contains(">>"))
    {
        info.type = NodeType.Asset;
        info.name = ExtractBetween(info.content, "<<", ">>");
    }
    else if (info.content.Contains("^||"))
    {
        info.type = NodeType.Reference;
        info.name = info.content.Substring(info.content.IndexOf("^||") + 3).Trim();
    }
    else
    {
        info.type = NodeType.Unknown;
    }

    return info;
}

private string ExtractBetween(string source, string start, string end)
{
    int startIdx = source.IndexOf(start);
    if (startIdx == -1) return "";
    
    startIdx += start.Length;
    int endIdx = source.IndexOf(end, startIdx);
    if (endIdx == -1) return "";

    return source.Substring(startIdx, endIdx - startIdx).Trim();
}

private List<SceneNode> BuildHierarchy(List<LineInfo> lines)
{
    var roots = new List<SceneNode>();
    var stack = new Stack<SceneNode>();

    foreach (var line in lines)
    {
        var node = new SceneNode
        {
            type = line.type,
            name = line.name,
            indentLevel = line.indentLevel
        };

        // Pop stack until we find the parent level
        while (stack.Count > 0 && stack.Peek().indentLevel >= node.indentLevel)
        {
            stack.Pop();
        }

        if (stack.Count == 0)
        {
            // Root level
            roots.Add(node);
        }
        else
        {
            // Child of top of stack
            var parent = stack.Peek();
            node.parent = parent;
            parent.children.Add(node);
        }

        // GameObjects can have children, so push to stack
        if (node.type == NodeType.GameObject)
        {
            stack.Push(node);
        }
    }

    return roots;
}
